{
  "name": "stockmon",
  "displayName": "stock-monitor",
  "description": "A stock monitoring and analysis platform. Stock Mate for Programmer",
  "version": "0.2.2",
  "publisher": "stockmon",
  "license": "MIT",
  "icon": "./resources/icon.png",
  "homepage": "https://stockmon.info",
  "keywords": [
    "stock",
    "trading",
    "finance",
    "market",
    "taiwan",
    "twse",
    "股票",
    "台股",
    "證券"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "stockmon.addStock",
        "title": "Add Stock Symbol",
        "category": "StockMon"
      },
      {
        "command": "stockmon.searchStocks",
        "title": "Search Stocks",
        "category": "StockMon"
      },
      {
        "command": "stockmon.deleteStock",
        "title": "Delete Stock Symbol",
        "category": "StockMon",
        "icon": "$(trash)"
      },
      {
        "command": "stockmon.refresh",
        "title": "Refresh Stock Data",
        "category": "StockMon"
      },
      {
        "command": "stockmon.refreshPortfolio",
        "title": "Refresh Portfolio",
        "category": "StockMon",
        "icon": "$(refresh)"
      },
      {
        "command": "stockmon.setCost",
        "title": "Set Stock Cost",
        "category": "StockMon",
        "icon": "$(edit)"
      },
      {
        "command": "stockmon.setPriceAlert",
        "title": "Set Price Alert",
        "category": "StockMon"
      },
      {
        "command": "stockmon.managePriceAlerts",
        "title": "Manage Price Alerts",
        "category": "StockMon"
      },
      {
        "command": "stockmon.manualCheckPriceAlerts",
        "title": "Manual Check Price Alerts",
        "category": "StockMon"
      },
      {
        "command": "stockmon.login",
        "title": "Login",
        "category": "StockMon"
      },
      {
        "command": "stockmon.logout",
        "title": "Logout",
        "category": "StockMon"
      },
      {
        "command": "stockmon.showPanel",
        "title": "Show Stock Monitor",
        "category": "Stock Monitor"
      },
      {
        "command": "stockmon.clearAllSubscriptions",
        "title": "Clear All Stock Subscriptions",
        "category": "StockMon"
      },
      {
        "command": "stockmon.enableProxy",
        "title": "Enable Proxy Server",
        "category": "StockMon"
      },
      {
        "command": "stockmon.disableProxy",
        "title": "Disable Proxy Server",
        "category": "StockMon"
      },
      {
        "command": "stockmon.listStock",
        "title": "StockMon: List Current Stocks"
      },
      {
        "command": "stockmon.showSessionInfo",
        "title": "Show Session Info",
        "category": "StockMon"
      },
      {
        "command": "stockmon.showWebSocketState",
        "title": "Show WebSocket State",
        "category": "StockMon"
      },
      {
        "command": "stockmon.checkConfig",
        "title": "Check Current Configuration",
        "category": "StockMon"
      },
      {
        "command": "stockmon.processSyncQueue",
        "title": "Process Sync Queue",
        "category": "StockMon"
      },
      {
        "command": "stockmon.setLogLevel",
        "title": "Set Log Level",
        "category": "StockMon"
      },
      {
        "command": "stockmon.showStockDetail",
        "title": "Show Stock Detail",
        "category": "StockMon",
        "icon": "$(info)"
      },
      {
        "command": "stockmon.showStockDetailFromButton",
        "title": "Show Stock Detail",
        "category": "StockMon",
        "icon": "$(info)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stockmon-sidebar",
          "title": "StockMon",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "stockmon-sidebar": [
        {
          "id": "stockmonPortfolio",
          "name": "Portfolio",
          "icon": "resources/icon.png",
          "contextualTitle": "Stock Portfolio"
        },
        {
          "id": "stockmon.watchlist",
          "name": "Watchlist",
          "icon": "resources/icon.png",
          "contextualTitle": "Stock Watchlist"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stockmon.refreshPortfolio",
          "when": "view == stockmonPortfolio",
          "group": "navigation"
        },
        {
          "command": "stockmon.addStock",
          "when": "view == stockmonPortfolio",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "stockmon.showStockDetailFromButton",
          "when": "view == stockmonPortfolio && viewItem == stock",
          "group": "inline@0"
        },
        {
          "command": "stockmon.setCost",
          "when": "view == stockmonPortfolio && viewItem == stock",
          "group": "inline@1"
        },
        {
          "command": "stockmon.deleteStock",
          "when": "view == stockmonPortfolio && viewItem == stock",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "StockMon",
      "properties": {
        "stockmon.useProxy": {
          "type": "boolean",
          "default": false,
          "description": "是否使用代理伺服器連接"
        },
        "stockmon.proxyApiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1/api",
          "description": "代理伺服器的 API 基礎 URL"
        },
        "stockmon.proxyWsHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "代理伺服器的 WebSocket host"
        },
        "stockmon.proxyWsPort": {
          "type": "number",
          "default": 80,
          "description": "代理伺服器的 WebSocket port"
        },
        "stockmon.logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
          "default": "INFO",
          "description": "設置 StockMon 擴展的日誌級別 (DEBUG 顯示所有日誌，INFO 顯示一般信息，WARNING 只顯示警告和錯誤，ERROR 只顯示錯誤)"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sssuperman/stockmon-ext.git"
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run start",
    "build:webview": "cd webview-ui && npm run build",
    "sandbox": "rimraf dist && npm run build:webview && npm run build && code --new-window --extensionDevelopmentPath=$PWD .",
    "sandbox-cli": "rimraf dist && npm run compile && node ./dist/extension.js",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "npm run package && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.12",
    "esbuild-plugin-copy": "^2.1.1",
    "mocha": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.10",
    "typescript": "^4.x.x",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.2.2",
    "axios": "^1.6.5",
    "eslint": "^8.57.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^11.0.5",
    "ws": "^8.16.0",
    "zustand": "^5.0.3"
  }
}
