{
  "name": "stockmon",
  "displayName": "stock-monitor",
  "description": "A stock monitoring and analysis platform. Stock Mate for Programmer",
  "version": "0.2.1",
  "publisher": "stockmon",
  "license": "MIT",
  "icon": "./resources/icon.png",
  "keywords": [
    "stock",
    "trading",
    "finance",
    "market",
    "taiwan",
    "twse",
    "股票",
    "台股",
    "證券"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "stockmon.addStock",
        "title": "Add Stock Symbol",
        "category": "StockMon"
      },
      {
        "command": "stockmon.searchStocks",
        "title": "Search Stocks",
        "category": "StockMon"
      },
      {
        "command": "stockmon.deleteStock",
        "title": "Delete Stock Symbol",
        "category": "StockMon"
      },
      {
        "command": "stockmon.refresh",
        "title": "Refresh Stock Price",
        "category": "StockMon"
      },
      {
        "command": "stockmon.setCost",
        "title": "Set Stock Cost",
        "category": "StockMon"
      },
      {
        "command": "stockmon.setPriceAlert",
        "title": "Set Price Alert",
        "category": "StockMon"
      },
      {
        "command": "stockmon.managePriceAlerts",
        "title": "Manage Price Alerts",
        "category": "StockMon"
      },
      {
        "command": "stockmon.manualCheckPriceAlerts",
        "title": "Manual Check Price Alerts",
        "category": "StockMon"
      },
      {
        "command": "stockmon.login",
        "title": "Login",
        "category": "StockMon"
      },
      {
        "command": "stockmon.logout",
        "title": "Logout",
        "category": "StockMon"
      },
      {
        "command": "stockmon.showPanel",
        "title": "Show Stock Monitor",
        "category": "Stock Monitor"
      },
      {
        "command": "stockmon.clearAllSubscriptions",
        "title": "Clear All Stock Subscriptions",
        "category": "StockMon"
      },
      {
        "command": "stockmon.switchToDevelopment",
        "title": "Switch to Development Environment"
      },
      {
        "command": "stockmon.switchToProduction",
        "title": "Switch to Production Environment"
      },
      {
        "command": "stockmon.listStock",
        "title": "StockMon: List Current Stocks"
      },
      {
        "command": "stockmon.showSessionInfo",
        "title": "Show Session Info",
        "category": "StockMon"
      },
      {
        "command": "stockmon.showWebSocketState",
        "title": "Show WebSocket State",
        "category": "StockMon"
      }
    ],
    "configuration": {
      "title": "Stock Monitor",
      "properties": {
        "stockmon.symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%stockmon.symbols.description%"
        },
        "stockmon.refreshInterval": {
          "type": "number",
          "default": 5,
          "description": "%stockmon.refreshInterval.description%"
        },
        "stockmon.environment": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ],
          "default": "production",
          "description": "選擇運行環境"
        },
        "stockmon.developmentConfig": {
          "type": "object",
          "properties": {
            "apiBaseUrl": {
              "type": "string",
              "default": "http://127.0.0.1/api",
              "description": "開發環境的 API 基礎 URL"
            },
            "wsHost": {
              "type": "string",
              "default": "127.0.0.1",
              "description": "開發環境的 WebSocket host"
            },
            "wsPort": {
              "type": "number",
              "default": 80,
              "description": "開發環境的 WebSocket port"
            }
          },
          "default": {
            "apiBaseUrl": "http://127.0.0.1/api",
            "wsHost": "127.0.0.1",
            "wsPort": 80
          },
          "description": "開發環境的連線設定"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sssuperman/stockmon-ext.git"
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run start",
    "build:webview": "cd webview-ui && npm run build",
    "sandbox": "rimraf dist && npm run build:webview && npm run build && code --new-window --extensionDevelopmentPath=$PWD .",
    "sandbox-cli": "rimraf dist && npm run compile && node ./dist/extension.js",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "npm run package && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.12",
    "esbuild-plugin-copy": "^2.1.1",
    "mocha": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.10",
    "typescript": "^4.x.x",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.2.2",
    "axios": "^1.6.5",
    "eslint": "^8.57.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^11.0.5",
    "ws": "^8.16.0",
    "zustand": "^5.0.3"
  }
}
